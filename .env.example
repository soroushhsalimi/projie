# Local development environment (never commit real values).
SARA_ENVIRONMENT=local
SARA_DATABASE_URL=sqlite+aiosqlite:///./sara.db
SARA_AUTO_CREATE_SCHEMA=true
SARA_SECRET_KEY=change-me-to-a-random-64-character-value
SARA_ACCESS_TOKEN_MINUTES=15
SARA_REFRESH_TOKEN_DAYS=30
SARA_REFRESH_COOKIE_NAME=sara_refresh
SARA_COOKIE_SECURE=false
SARA_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
